rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Users can only read/write their own document
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Users can only read/write their own entries
    match /users/{userId}/entries/{entryId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Leaderboard: any authenticated user can read, but only write your own row
    match /leaderboard/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Public profiles: world-readable so shareable cards and /u/{uid} pages
    // work for logged-out visitors. Only the owner can write their own profile.
    match /profiles/{userId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Founding-member counter: public-readable so the marketing site can show
    // the live "X / 50 claimed" count. Writes are restricted to single
    // monotonic increments capped at 50, so an authenticated client can only
    // ever claim the next slot during the transaction in src/lib/founders.ts.
    match /meta/founding {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.count == 1
        && request.resource.data.max == 50;
      allow update: if request.auth != null
        && request.resource.data.count == resource.data.count + 1
        && request.resource.data.count <= 50
        && request.resource.data.max == resource.data.max;
    }
  }
}
